# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Secret used to sign guest session tokens. MUST be set in production.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_SECONDS=86400

# Instance sizing (see SPEC 11.3 - to be confirmed by load test)
INSTANCE_CAPACITY=25
# Seconds a disconnected player keeps their seat / avatar before cleanup (SPEC 5.3, 16.2)
DISCONNECT_GRACE_SECONDS=20

# ---- Persistence (optional) ----
# Leave DATABASE_URL empty to use the in-memory store (dev / prototype).
DATABASE_URL=
# Leave REDIS_URL empty to keep presence in process memory (single node).
REDIS_URL=

# ---- Voice / SFU (optional, SPEC 6.3) ----
# Without these the cafe still works; voice is reported as unavailable.
# For LiveKit Cloud: create a project at https://cloud.livekit.io, then
# Settings > Keys. LIVEKIT_URL is the wss:// URL shown for the project.
# These stay server-side; the browser only ever receives a short-lived token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_TOKEN_TTL_SECONDS=600

# ---- Web ----
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# ---- Live weather & time (optional) ----
# The window, room lighting and rain follow real weather from Open-Meteo
# (free, no key). Set the café's location; 0 turns it off (rainy afternoon).
NEXT_PUBLIC_LIVE_WEATHER=1
NEXT_PUBLIC_WEATHER_LAT=10.7769
NEXT_PUBLIC_WEATHER_LON=106.7009
NEXT_PUBLIC_WEATHER_LABEL=TP. Hồ Chí Minh

# ---- Window sky (public/skyboxes) ----
# Empty = follows the café clock (morning / day / night panoramas).
# space | alien = a fixed themed backdrop.
NEXT_PUBLIC_SKYBOX_THEME=

# ---- Khu Chơi Game ----
# Secret for uploading games into the database (npm run seed:games).
# Unset = uploads off; the library is still readable.
GAMES_ADMIN_TOKEN=
